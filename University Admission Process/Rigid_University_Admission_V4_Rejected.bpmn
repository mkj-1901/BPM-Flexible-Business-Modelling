<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RigidUniversityAdmissionV4" targetNamespace="http://bpmn.io/schema/bpmn" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/MODEL.xsd">
  <bpmn:process id="RigidUniversityAdmissionV4" name="V4 - Rejected Application" isExecutable="true">
    <bpmn:documentation>V4 Rejected Application: Five sequential activities representing an admission process where the applicant is ultimately rejected. Application is submitted, eligibility is checked manually, an entrance exam is conducted, merit is evaluated by a committee, and the application is rejected. No enrollment takes place.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent" name="Start" />
    <bpmn:task id="SubmitApplication" name="Submit Application" />
    <bpmn:task id="CheckEligibilityManual" name="Check Eligibility (Manual)" />
    <bpmn:task id="ConductEntranceExam" name="Conduct Entrance Exam" />
    <bpmn:task id="EvaluateMeritCommittee" name="Evaluate Merit (Committee)" />
    <bpmn:task id="RejectApplication" name="Reject Application" />
    <bpmn:endEvent id="EndEvent" name="End" />
    <bpmn:sequenceFlow id="Flow_Start_Submit" sourceRef="StartEvent" targetRef="SubmitApplication" />
    <bpmn:sequenceFlow id="Flow_Submit_Eligibility" sourceRef="SubmitApplication" targetRef="CheckEligibilityManual" />
    <bpmn:sequenceFlow id="Flow_Eligibility_Exam" sourceRef="CheckEligibilityManual" targetRef="ConductEntranceExam" />
    <bpmn:sequenceFlow id="Flow_Exam_Merit" sourceRef="ConductEntranceExam" targetRef="EvaluateMeritCommittee" />
    <bpmn:sequenceFlow id="Flow_Merit_Reject" sourceRef="EvaluateMeritCommittee" targetRef="RejectApplication" />
    <bpmn:sequenceFlow id="Flow_Reject_End" sourceRef="RejectApplication" targetRef="EndEvent" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_V4">
    <bpmndi:BPMNPlane id="BPMNPlane_V4" bpmnElement="RigidUniversityAdmissionV4">
      <bpmndi:BPMNShape id="StartEvent_di" bpmnElement="StartEvent">
        <dc:Bounds x="70" y="170" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubmitApplication_di" bpmnElement="SubmitApplication">
        <dc:Bounds x="145" y="158" width="140" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CheckEligibilityManual_di" bpmnElement="CheckEligibilityManual">
        <dc:Bounds x="325" y="158" width="170" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ConductEntranceExam_di" bpmnElement="ConductEntranceExam">
        <dc:Bounds x="535" y="158" width="170" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EvaluateMeritCommittee_di" bpmnElement="EvaluateMeritCommittee">
        <dc:Bounds x="745" y="158" width="180" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RejectApplication_di" bpmnElement="RejectApplication">
        <dc:Bounds x="965" y="158" width="150" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_di" bpmnElement="EndEvent">
        <dc:Bounds x="1155" y="170" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Submit_di" bpmnElement="Flow_Start_Submit">
        <di:waypoint x="106" y="188" />
        <di:waypoint x="145" y="188" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Submit_Eligibility_di" bpmnElement="Flow_Submit_Eligibility">
        <di:waypoint x="285" y="188" />
        <di:waypoint x="325" y="188" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Eligibility_Exam_di" bpmnElement="Flow_Eligibility_Exam">
        <di:waypoint x="495" y="188" />
        <di:waypoint x="535" y="188" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Exam_Merit_di" bpmnElement="Flow_Exam_Merit">
        <di:waypoint x="705" y="188" />
        <di:waypoint x="745" y="188" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Merit_Reject_di" bpmnElement="Flow_Merit_Reject">
        <di:waypoint x="925" y="188" />
        <di:waypoint x="965" y="188" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Reject_End_di" bpmnElement="Flow_Reject_End">
        <di:waypoint x="1115" y="188" />
        <di:waypoint x="1155" y="188" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>