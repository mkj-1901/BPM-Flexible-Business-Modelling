# Google Gemini API key (Google AI Studio "AIza..." / "AQ...." or Vertex AI Express "AQ....")
# Keep your real key in .env (which is ignored by .gitignore).
# The backend checks API_KEY first and falls back to GEMINI_API_KEY.
API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional: auto | gemini-developer | vertex-express
GEMINI_PROVIDER=auto
PORT=3000
