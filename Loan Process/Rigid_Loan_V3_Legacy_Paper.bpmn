<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RigidLoanV3LegacyPaper" targetNamespace="http://bpmn.io/schema/bpmn" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/MODEL.xsd">
  <bpmn:process id="RigidLoanV3LegacyPaper" name="Rigid Loan V3 – Legacy Paper-File" isExecutable="true">
    <bpmn:documentation>V3 Legacy Paper-File rigid model: six sequential activities. Uses Check Paper Archive instead of Check Credit System.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent" name="Start" />
    <bpmn:task id="ReceiveRequest" name="Receive Request" />
    <bpmn:task id="CheckPaperArchive" name="Check Paper Archive" />
    <bpmn:task id="VerifyDocuments" name="Verify Documents" />
    <bpmn:task id="AssessManually" name="Assess Manually" />
    <bpmn:task id="AcceptLoan" name="Accept Loan" />
    <bpmn:task id="ArchiveRequest" name="Archive Request" />
    <bpmn:endEvent id="EndEvent" name="End" />
    <bpmn:sequenceFlow id="Flow_Start_Receive" sourceRef="StartEvent" targetRef="ReceiveRequest" />
    <bpmn:sequenceFlow id="Flow_Receive_Paper" sourceRef="ReceiveRequest" targetRef="CheckPaperArchive" />
    <bpmn:sequenceFlow id="Flow_Paper_Verify" sourceRef="CheckPaperArchive" targetRef="VerifyDocuments" />
    <bpmn:sequenceFlow id="Flow_Verify_Assess" sourceRef="VerifyDocuments" targetRef="AssessManually" />
    <bpmn:sequenceFlow id="Flow_Assess_Accept" sourceRef="AssessManually" targetRef="AcceptLoan" />
    <bpmn:sequenceFlow id="Flow_Accept_Archive" sourceRef="AcceptLoan" targetRef="ArchiveRequest" />
    <bpmn:sequenceFlow id="Flow_Archive_End" sourceRef="ArchiveRequest" targetRef="EndEvent" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_RigidLoanV3LegacyPaper">
    <bpmndi:BPMNPlane id="BPMNPlane_RigidLoanV3LegacyPaper" bpmnElement="RigidLoanV3LegacyPaper">
      <bpmndi:BPMNShape id="StartEvent_di" bpmnElement="StartEvent">
        <dc:Bounds x="70" y="170" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReceiveRequest_di" bpmnElement="ReceiveRequest">
        <dc:Bounds x="145" y="158" width="125" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CheckPaperArchive_di" bpmnElement="CheckPaperArchive">
        <dc:Bounds x="310" y="158" width="150" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="VerifyDocuments_di" bpmnElement="VerifyDocuments">
        <dc:Bounds x="500" y="158" width="135" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AssessManually_di" bpmnElement="AssessManually">
        <dc:Bounds x="675" y="158" width="130" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AcceptLoan_di" bpmnElement="AcceptLoan">
        <dc:Bounds x="845" y="158" width="120" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ArchiveRequest_di" bpmnElement="ArchiveRequest">
        <dc:Bounds x="1005" y="158" width="130" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_di" bpmnElement="EndEvent">
        <dc:Bounds x="1175" y="170" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Receive_di" bpmnElement="Flow_Start_Receive">
        <di:waypoint x="106" y="188" />
        <di:waypoint x="145" y="188" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Receive_Paper_di" bpmnElement="Flow_Receive_Paper">
        <di:waypoint x="270" y="188" />
        <di:waypoint x="310" y="188" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Paper_Verify_di" bpmnElement="Flow_Paper_Verify">
        <di:waypoint x="460" y="188" />
        <di:waypoint x="500" y="188" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Verify_Assess_di" bpmnElement="Flow_Verify_Assess">
        <di:waypoint x="635" y="188" />
        <di:waypoint x="675" y="188" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Assess_Accept_di" bpmnElement="Flow_Assess_Accept">
        <di:waypoint x="805" y="188" />
        <di:waypoint x="845" y="188" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Accept_Archive_di" bpmnElement="Flow_Accept_Archive">
        <di:waypoint x="965" y="188" />
        <di:waypoint x="1005" y="188" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Archive_End_di" bpmnElement="Flow_Archive_End">
        <di:waypoint x="1135" y="188" />
        <di:waypoint x="1175" y="188" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
