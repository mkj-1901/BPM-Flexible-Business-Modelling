<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_FlexibleLoanApplicationProcess" targetNamespace="http://bpmn.io/schema/bpmn" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/MODEL.xsd">
  <bpmn:process id="FlexibleLoanApplicationProcess" name="Unified Flexible Loan Application Process" isExecutable="true">
    <bpmn:documentation>Unified flexible model for four illustrative variants: V1 Standard Branch, V2 Digital Fast-Track, V3 Legacy Paper-File, and V4 High-Risk Rejected. Set process variable variant to V1, V2, V3, or V4 to select the intended path. Gateway conditions use Camunda 8 FEEL expressions. Activity shapes are generic BPMN tasks for diagramming; configure executable implementations or task types before running in an engine.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent" name="Start" />
    <bpmn:task id="ReceiveRequest" name="Receive Request" />
    <bpmn:exclusiveGateway id="CreditSplit" name="Credit Source" gatewayDirection="Diverging" default="F_CreditSplit_System" />
    <bpmn:task id="CheckCreditSystem" name="Check Credit System" />
    <bpmn:task id="CheckPaperArchive" name="Check Paper Archive" />
    <bpmn:exclusiveGateway id="CreditJoin" gatewayDirection="Converging" />
    <bpmn:task id="VerifyDocuments" name="Verify Documents" />
    <bpmn:exclusiveGateway id="AssessmentSplit" name="Assessment Mode" gatewayDirection="Diverging" default="F_AssessSplit_Manual" />
    <bpmn:task id="AssessManually" name="Assess Manually" />
    <bpmn:task id="AutoApproveCheck" name="Auto-Approve Check" />
    <bpmn:exclusiveGateway id="AssessmentJoin" gatewayDirection="Converging" />
    <bpmn:exclusiveGateway id="DecisionSplit" name="Loan Decision" gatewayDirection="Diverging" default="F_DecisionSplit_Accept" />
    <bpmn:task id="AcceptLoan" name="Accept Loan" />
    <bpmn:task id="RejectLoan" name="Reject Loan" />
    <bpmn:exclusiveGateway id="DecisionJoin" gatewayDirection="Converging" />
    <bpmn:exclusiveGateway id="ArchiveSplit" name="Archive?" gatewayDirection="Diverging" default="F_ArchiveSplit_Skip" />
    <bpmn:task id="ArchiveRequest" name="Archive Request" />
    <bpmn:exclusiveGateway id="ArchiveJoin" gatewayDirection="Converging" />
    <bpmn:endEvent id="EndEvent" name="End" />
    <bpmn:sequenceFlow id="F_Start_Receive" sourceRef="StartEvent" targetRef="ReceiveRequest" />
    <bpmn:sequenceFlow id="F_Receive_CreditSplit" sourceRef="ReceiveRequest" targetRef="CreditSplit" />
    <bpmn:sequenceFlow id="F_CreditSplit_System" sourceRef="CreditSplit" targetRef="CheckCreditSystem" name="Digital / Standard" />
    <bpmn:sequenceFlow id="F_CreditSplit_Paper" sourceRef="CreditSplit" targetRef="CheckPaperArchive" name="Legacy">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= variant = "V3"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_System_CreditJoin" sourceRef="CheckCreditSystem" targetRef="CreditJoin" />
    <bpmn:sequenceFlow id="F_Paper_CreditJoin" sourceRef="CheckPaperArchive" targetRef="CreditJoin" />
    <bpmn:sequenceFlow id="F_CreditJoin_Verify" sourceRef="CreditJoin" targetRef="VerifyDocuments" />
    <bpmn:sequenceFlow id="F_Verify_AssessSplit" sourceRef="VerifyDocuments" targetRef="AssessmentSplit" />
    <bpmn:sequenceFlow id="F_AssessSplit_Manual" sourceRef="AssessmentSplit" targetRef="AssessManually" name="Standard / High-risk" />
    <bpmn:sequenceFlow id="F_AssessSplit_Auto" sourceRef="AssessmentSplit" targetRef="AutoApproveCheck" name="Low-risk / Digital">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= variant = "V2"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Manual_AssessJoin" sourceRef="AssessManually" targetRef="AssessmentJoin" />
    <bpmn:sequenceFlow id="F_Auto_AssessJoin" sourceRef="AutoApproveCheck" targetRef="AssessmentJoin" />
    <bpmn:sequenceFlow id="F_AssessJoin_DecisionSplit" sourceRef="AssessmentJoin" targetRef="DecisionSplit" />
    <bpmn:sequenceFlow id="F_DecisionSplit_Accept" sourceRef="DecisionSplit" targetRef="AcceptLoan" name="Eligible" />
    <bpmn:sequenceFlow id="F_DecisionSplit_Reject" sourceRef="DecisionSplit" targetRef="RejectLoan" name="Ineligible">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= variant = "V4"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Accept_DecisionJoin" sourceRef="AcceptLoan" targetRef="DecisionJoin" />
    <bpmn:sequenceFlow id="F_Reject_DecisionJoin" sourceRef="RejectLoan" targetRef="DecisionJoin" />
    <bpmn:sequenceFlow id="F_DecisionJoin_ArchiveSplit" sourceRef="DecisionJoin" targetRef="ArchiveSplit" />
    <bpmn:sequenceFlow id="F_ArchiveSplit_Archive" sourceRef="ArchiveSplit" targetRef="ArchiveRequest" name="Branch dossier">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= variant = "V1" or variant = "V3"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ArchiveSplit_Skip" sourceRef="ArchiveSplit" targetRef="ArchiveJoin" name="Digital / Rejected" />
    <bpmn:sequenceFlow id="F_Archive_ArchiveJoin" sourceRef="ArchiveRequest" targetRef="ArchiveJoin" />
    <bpmn:sequenceFlow id="F_ArchiveJoin_End" sourceRef="ArchiveJoin" targetRef="EndEvent" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_FlexibleLoanApplicationProcess">
    <bpmndi:BPMNPlane id="BPMNPlane_FlexibleLoanApplicationProcess" bpmnElement="FlexibleLoanApplicationProcess">
