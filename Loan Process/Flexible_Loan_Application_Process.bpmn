      <bpmndi:BPMNShape id="DecisionJoin_di" bpmnElement="DecisionJoin">
        <dc:Bounds x="1240" y="247" width="32" height="32" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ArchiveSplit_di" bpmnElement="ArchiveSplit">
        <dc:Bounds x="1295" y="247" width="32" height="32" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ArchiveRequest_di" bpmnElement="ArchiveRequest">
        <dc:Bounds x="1360" y="165" width="130" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ArchiveJoin_di" bpmnElement="ArchiveJoin">
        <dc:Bounds x="1525" y="247" width="32" height="32" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_di" bpmnElement="EndEvent">
        <dc:Bounds x="1590" y="245" width="36" height="36" />
      </bpmndi:BPMNShape>
