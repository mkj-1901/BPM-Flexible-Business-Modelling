<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_FlexibleEmployeeRecruitmentProcess" targetNamespace="http://bpmn.io/schema/bpmn" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/MODEL.xsd">
  <bpmn:process id="FlexibleEmployeeRecruitmentProcess" name="Unified Flexible Employee Recruitment Process" isExecutable="true">
    <bpmn:documentation>Unified flexible model for four employee recruitment variants: V1 Standard Corporate Hire, V2 Remote Fast-Track Hire, V3 Legacy Paper-Dossier Hire, and V4 Rejected Candidate. Set process variable variant to V1, V2, V3, or V4 to select the intended path. Gateway conditions use Camunda 8 FEEL expressions. Activity shapes are generic BPMN tasks for diagramming; configure executable implementations or task types before running in an engine.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent" name="Start" />
    <bpmn:task id="ReceiveApplication" name="Receive Application" />
    <bpmn:exclusiveGateway id="ScreeningSplit" name="Screening Source" gatewayDirection="Diverging" default="F_ScreenSplit_Resume" />
    <bpmn:task id="ScreenResume" name="Screen Resume" />
    <bpmn:task id="ReviewPaperDossier" name="Review Paper Dossier" />
    <bpmn:exclusiveGateway id="ScreeningJoin" gatewayDirection="Converging" />
    <bpmn:task id="VerifyCredentials" name="Verify Credentials" />
    <bpmn:exclusiveGateway id="AssessmentSplit" name="Assessment Mode" gatewayDirection="Diverging" default="F_AssessSplit_Interview" />
    <bpmn:task id="ConductPanelInterview" name="Conduct Panel Interview" />
    <bpmn:task id="RunAutomatedAssessment" name="Run Automated Assessment" />
    <bpmn:exclusiveGateway id="AssessmentJoin" gatewayDirection="Converging" />
    <bpmn:exclusiveGateway id="DecisionSplit" name="Hiring Decision" gatewayDirection="Diverging" default="F_DecisionSplit_Offer" />
    <bpmn:task id="ExtendJobOffer" name="Extend Job Offer" />
    <bpmn:task id="RejectCandidate" name="Reject Candidate" />
    <bpmn:exclusiveGateway id="DecisionJoin" gatewayDirection="Converging" />
    <bpmn:exclusiveGateway id="OrientationSplit" name="Orientation?" gatewayDirection="Diverging" default="F_OrientSplit_Skip" />
    <bpmn:task id="ConductOrientation" name="Conduct Orientation" />
    <bpmn:exclusiveGateway id="OrientationJoin" gatewayDirection="Converging" />
    <bpmn:endEvent id="EndEvent" name="End" />
    <bpmn:sequenceFlow id="F_Start_Receive" sourceRef="StartEvent" targetRef="ReceiveApplication" />
    <bpmn:sequenceFlow id="F_Receive_ScreenSplit" sourceRef="ReceiveApplication" targetRef="ScreeningSplit" />
    <bpmn:sequenceFlow id="F_ScreenSplit_Resume" sourceRef="ScreeningSplit" targetRef="ScreenResume" name="Digital / Standard" />
    <bpmn:sequenceFlow id="F_ScreenSplit_Paper" sourceRef="ScreeningSplit" targetRef="ReviewPaperDossier" name="Legacy">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= variant = "V3"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Resume_ScreenJoin" sourceRef="ScreenResume" targetRef="ScreeningJoin" />
    <bpmn:sequenceFlow id="F_Paper_ScreenJoin" sourceRef="ReviewPaperDossier" targetRef="ScreeningJoin" />
    <bpmn:sequenceFlow id="F_ScreenJoin_Verify" sourceRef="ScreeningJoin" targetRef="VerifyCredentials" />
    <bpmn:sequenceFlow id="F_Verify_AssessSplit" sourceRef="VerifyCredentials" targetRef="AssessmentSplit" />
    <bpmn:sequenceFlow id="F_AssessSplit_Interview" sourceRef="AssessmentSplit" targetRef="ConductPanelInterview" name="Standard / Rejected" />
    <bpmn:sequenceFlow id="F_AssessSplit_Auto" sourceRef="AssessmentSplit" targetRef="RunAutomatedAssessment" name="Remote Fast-Track">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= variant = "V2"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Interview_AssessJoin" sourceRef="ConductPanelInterview" targetRef="AssessmentJoin" />
    <bpmn:sequenceFlow id="F_Auto_AssessJoin" sourceRef="RunAutomatedAssessment" targetRef="AssessmentJoin" />
    <bpmn:sequenceFlow id="F_AssessJoin_DecisionSplit" sourceRef="AssessmentJoin" targetRef="DecisionSplit" />
    <bpmn:sequenceFlow id="F_DecisionSplit_Offer" sourceRef="DecisionSplit" targetRef="ExtendJobOffer" name="Selected" />
    <bpmn:sequenceFlow id="F_DecisionSplit_Reject" sourceRef="DecisionSplit" targetRef="RejectCandidate" name="Not Selected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= variant = "V4"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Offer_DecisionJoin" sourceRef="ExtendJobOffer" targetRef="DecisionJoin" />
    <bpmn:sequenceFlow id="F_Reject_DecisionJoin" sourceRef="RejectCandidate" targetRef="DecisionJoin" />
    <bpmn:sequenceFlow id="F_DecisionJoin_OrientSplit" sourceRef="DecisionJoin" targetRef="OrientationSplit" />
    <bpmn:sequenceFlow id="F_OrientSplit_Orient" sourceRef="OrientationSplit" targetRef="ConductOrientation" name="In-person onboarding">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= variant = "V1" or variant = "V3"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_OrientSplit_Skip" sourceRef="OrientationSplit" targetRef="OrientationJoin" name="Remote / Rejected" />
    <bpmn:sequenceFlow id="F_Orient_OrientJoin" sourceRef="ConductOrientation" targetRef="OrientationJoin" />
    <bpmn:sequenceFlow id="F_OrientJoin_End" sourceRef="OrientationJoin" targetRef="EndEvent" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_FlexibleEmployeeRecruitmentProcess">
    <bpmndi:BPMNPlane id="BPMNPlane_FlexibleEmployeeRecruitmentProcess" bpmnElement="FlexibleEmployeeRecruitmentProcess">
